# MSF Phantom QA — configuration template.
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).
#
#   cp .env.example .env
#   python -m phantom_qa.manage gen-secret     # -> PHANTOMQA_SECRET_KEY
#   python -m phantom_qa.manage set-password   # -> PHANTOMQA_PASSWORD_HASH
#   python -m phantom_qa.manage check          # verify before going live

# ---------------------------------------------------------------- environment
# "development" (default) or "production".
# production turns ON auth, HTTPS-only cookies and proxy handling, and REFUSES
# to start without a secret key or with a plain-text password.
PHANTOMQA_ENV=development

# ------------------------------------------------------------- authentication
PHANTOMQA_AUTH_ENABLED=true
PHANTOMQA_USERNAME=qa

# Password hash from `python -m phantom_qa.manage set-password` (PBKDF2-SHA256).
PHANTOMQA_PASSWORD_HASH=

# Plain-text password — DEVELOPMENT ONLY, rejected in production.
# PHANTOMQA_PASSWORD=

PHANTOMQA_SESSION_HOURS=12
PHANTOMQA_MAX_LOGIN_ATTEMPTS=8
PHANTOMQA_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------- secrets
# Signs session cookies. Rotating it logs everyone out. Required in production.
PHANTOMQA_SECRET_KEY=

# --------------------------------------------------------- transport / hosting
# Serve behind a TLS-terminating reverse proxy (nginx/Caddy/Traefik).
PHANTOMQA_HTTPS_ONLY=true
PHANTOMQA_BEHIND_PROXY=true

# Comma-separated Host header allow-list. Leave empty ONLY for local use.
PHANTOMQA_ALLOWED_HOSTS=phantomqa.example.org

# Comma-separated extra CORS origins. Normally empty — the UI is same-origin.
PHANTOMQA_CORS_ORIGINS=

# ---------------------------------------------------------------------- limits
PHANTOMQA_MAX_UPLOAD_MB=200
