# MSF Phantom QA — configuration template.
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).
#
#   cp .env.example .env
#   python -m phantom_qa.manage gen-secret     # -> PHANTOMQA_SECRET_KEY
#   python -m phantom_qa.manage set-password   # -> PHANTOMQA_PASSWORD_HASH
#   python -m phantom_qa.manage check          # verify before going live

# ---------------------------------------------------------------- environment
# "development" (default) or "production".
# production turns ON auth, HTTPS-only cookies and proxy handling, and REFUSES
# to start without a secret key or with a plain-text password.
PHANTOMQA_ENV=development

# ------------------------------------------------------------- authentication
PHANTOMQA_AUTH_ENABLED=true
PHANTOMQA_USERNAME=qa

# Password hash from `python -m phantom_qa.manage set-password` (PBKDF2-SHA256).
PHANTOMQA_PASSWORD_HASH=

# Plain-text password — DEVELOPMENT ONLY, rejected in production.
# PHANTOMQA_PASSWORD=

PHANTOMQA_SESSION_HOURS=12
PHANTOMQA_MAX_LOGIN_ATTEMPTS=8
PHANTOMQA_LOCKOUT_MINUTES=15

# ------------------------------------------------------------------- secrets
# Signs session cookies. Rotating it logs everyone out. Required in production.
PHANTOMQA_SECRET_KEY=

# --------------------------------------------------------- transport / hosting
# Serve behind a TLS-terminating reverse proxy (nginx/Caddy/Traefik).
PHANTOMQA_HTTPS_ONLY=true
PHANTOMQA_BEHIND_PROXY=true

# Comma-separated Host header allow-list. Leave empty ONLY for local use.
PHANTOMQA_ALLOWED_HOSTS=something.example.org

# Sub-path mount. Set this when the app is NOT at the domain root, e.g. for
# https://something.example.org/x-ray/ use "/x-ray". Leave empty for the root.
# It controls the <base href> given to the browser and scopes the session
# cookie to the mount, so another app on the same domain never receives it.
PHANTOMQA_ROOT_PATH=/x-ray

# Comma-separated extra CORS origins. Normally empty — the UI is same-origin.
PHANTOMQA_CORS_ORIGINS=

# ------------------------------------------------------- administrator actions
# This SEPARATE password gates the decisions an ordinary user must not make:
#   * DELETING an analysis (which also destroys the stored source file)
#   * VALIDATING an analysis (validated / conditionally validated / not validated)
#   * DISCARDING a phantom's stored measuring-point layout
# Give it only to people entitled to make those calls, and do NOT reuse the
# everyday login password.
# Create with: python -m phantom_qa.manage set-admin-password
# LEAVE EMPTY to disable all three. That is the safe default for deletion,
# but it also means nobody can sign analyses off.
PHANTOMQA_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------- limits
PHANTOMQA_MAX_UPLOAD_MB=200

# Seconds one analysis may spend measuring before the remaining tests are
# abandoned and the result is recorded as a failure. A backstop, not a target:
# every scan measured so far finishes well inside ten seconds, so reaching this
# means something is wrong that is better reported than waited on. The check
# happens between tests, so a single long-running test can overshoot it.
# 0 disables the limit entirely.
# PHANTOMQA_ANALYSIS_TIMEOUT_S=120

# ------------------------------------------------------------------ data root
# Directory that CONTAINS data/ (the database, uploaded scans, backups).
# Leave unset to use the application directory — what every install does today.
# Set it to keep the data on a separate volume, or to be certain that a stray
# import or a test run cannot open the live database.
# PHANTOMQA_DATA_ROOT=/var/lib/phantomqa

# --------------------------------------------------------------------- logging
# phantomqa.log  application activity      (rotates at MAX_MB, BACKUPS kept)
# errors.log     warnings and errors only
# audit.log      who did what to the data  (AUDIT_BACKUPS kept — keep longer)
PHANTOMQA_LOG_DIR=logs
PHANTOMQA_LOG_LEVEL=INFO
PHANTOMQA_LOG_MAX_MB=10
PHANTOMQA_LOG_BACKUPS=10
PHANTOMQA_LOG_AUDIT_BACKUPS=30
PHANTOMQA_LOG_CONSOLE=true

# ---------------------------------------------------- server (process level)
# Read by gunicorn.conf.py when deployed as a service, and by run_app.py when
# run directly. Not consumed by the application code itself, which is why
# they sit apart from the sections above.
# PHANTOMQA_BIND=127.0.0.1:8777          # gunicorn bind address
# PHANTOMQA_WORKERS=                     # default: min(cpu_count, 4)
# PHANTOMQA_TIMEOUT=120                  # request timeout, seconds
# PHANTOMQA_FORWARDED_ALLOW_IPS=127.0.0.1   # proxies allowed to set X-Forwarded-For
# PHANTOMQA_HOST=127.0.0.1               # run_app.py only
# PHANTOMQA_PORT=8777                    # run_app.py only
