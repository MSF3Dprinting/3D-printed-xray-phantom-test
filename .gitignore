# ---------------------------------------------------------------- scan data
# Never commit image exports. They are large, they are the measurement input
# rather than source, and they may carry site/patient-identifying DICOM tags.
/20260727 MSF/
/New Phantom/
/HQ testing/
/Field testing/
Export_*/
# Future scan drops are dated folders (YYYYMMDD ...) — ignored by pattern.
# If you ever add a NON-scan folder whose name starts with 8 digits, rename it
# or force-add it (git add -f), otherwise it is silently ignored.
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]*/
*.dcm
*.dicom
DICOMDIR

# Uploaded scans + analysis database created at runtime by the web app.
# (data/phantom_definitions/ IS tracked — it is the phantom geometry config.)
# The -wal and -shm companions are SQLite's write-ahead log and its shared
# memory index: runtime-only, recreated automatically, never committed.
/data/uploads/
/data/backup/
# Pictures of each scan kept for the comparison report: cut from the scans, so
# never committed; derived, so rebuilt on demand if lost.
/data/thumbs/
/data/*.sqlite3
/data/*.sqlite3-wal
/data/*.sqlite3-shm
/data/*.sqlite3-journal

# Headless CLI output
qa_output*/

# Log files (they contain site names, operators and client addresses)
logs/
*.log
*.log.[0-9]*

# ---------------------------------------------------------------- secrets
# Real configuration and credentials. .env.example IS tracked as the template.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------------------------------------------------------------- reference docs
# Source manual — distributed separately, not part of the code base.
*.docx
~$*.docx

# ---------------------------------------------------------------- Claude Code
.claude/
CLAUDE.md
.claude.json
.claude.json.backup

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------- editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
